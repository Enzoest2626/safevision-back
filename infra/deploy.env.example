# Copiar este archivo a infra/deploy.env y completar con tus valores reales.
# deploy.env NUNCA se commitea (*.env ya esta en .gitignore).

AWS_REGION=us-east-1
# Nombre del profile de AWS CLI a usar (aws configure --profile <nombre>).
# El script exige que esto este seteado — no cae al profile "default" solo.
AWS_PROFILE=safevision-demo
STACK_NAME=safevision-demo
ASSETS_BUCKET=safevision-demo-assets
# Bucket de evidencia (foto + clip de cada incidente). Opcional: si se omite,
# deploy.sh usa "<ASSETS_BUCKET>-evidence" y lo crea privado, con expiracion a 60 dias.
# EVIDENCE_BUCKET=safevision-demo-evidence
# Ruta al repo del modulo CV, relativa a infra/ (este directorio).
CV_REPO_PATH=../../safevision-computer-vision

KEY_PAIR_NAME=safevision-demo
PEM_PATH=./safevision-demo.pem

# Tu IP publica (curl ifconfig.me) + /32
MY_IP_CIDR=190.1.2.3/32

# aws ec2 describe-vpcs --filters Name=is-default,Values=true --query 'Vpcs[0].VpcId' --output text
VPC_ID=vpc-xxxxxxxxxxxxxxxxx
# aws ec2 describe-subnets --filters Name=vpc-id,Values=<VPC_ID> --query 'Subnets[0].SubnetId' --output text
SUBNET_ID=subnet-xxxxxxxxxxxxxxxxx

# Password del usuario safevision en RDS. Sin comillas, backticks ni $.
DB_MASTER_PASSWORD=

# python -c "import secrets; print(secrets.token_hex(32))"
ALERT_SERVICE_TOKEN=

# Firma de los JWT de /api/v1/auth/login (minimo 32 bytes). Opcional: si se
# deja vacio, deploy.sh genera uno nuevo en cada create-stack.
JWT_SECRET=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
