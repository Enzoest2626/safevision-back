# Variables para docker-compose.yml (prueba local con Docker / Rancher Desktop).
# Copiar a .env en la raiz si querés override los defaults. Distinto de
# infra/deploy.env.example (ese es para el deploy real a AWS via
# CloudFormation).

# dev | prd — se propaga a SPRING_PROFILES_ACTIVE (backend), a APP_ENV del
# frontend y del CV, mismos valores en los 3 proyectos.
APP_ENV=dev

CV_REPO_PATH=../safevision-computer-vision
FRONTEND_REPO_PATH=../safevision-front
ALERT_SERVICE_TOKEN=dev-token
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FLASK_SECRET_KEY=dev-secret-change-me

# Bucket real de AWS para evidencia (foto+clip) — no hay S3 local en este
# compose. Sin esto, el CV no sube nada y no se genera ningun incidente
# de punta a punta (el broker MQTT si es local, no necesita esto).
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
